# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Supabase (web login + data access through PostgREST) ---------------------
# From the Supabase dashboard: Project Settings > API Keys > "Legacy API keys" tab.
# Leave the placeholders as they are when you only run SQL / tests on plain Postgres;
# scripts/seed-users.ts then skips the auth step and the SQL seed inserts the demo logins.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server side only. Never expose in the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Direct Postgres connection (migrations, seed, CI tenant check, Vitest) ----
# One of the two:
# Local plain Postgres (docker compose up -d in this repo, or the sibling onion-crm-postgres):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/onion_crm
# Hosted Supabase (dashboard: Connect > Direct > URI > Session pooler, port 5432; not Transaction pooler):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/onion_crm

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo login (server side only, read at request time; contracts A11) --------
# DEMO_MODE=true shows the "Try as" one-tap buttons on /login. Remove it (or set false) for a real client.
DEMO_MODE=true
# Password of the four demo users: scripts/seed-users.ts sets it, the "Try as" server action signs in
# with it. Server env only (never NEXT_PUBLIC_), never commit a real value. "Try as" stays hidden while empty.
DEMO_PASSWORD=
